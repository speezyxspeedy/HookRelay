# Server configuration
PORT=3000
NODE_ENV=development

# Administrative API key used to authenticate REST API requests (X-API-Key or Bearer token).
# Leave empty on first local run to claim an admin key via the HookRelay setup screen,
# or set a strong secret here to override any claimed key.
HOOKRELAY_API_KEY=

# Persistent SQLite database file path (relative to workspace root or absolute)
HOOKRELAY_DB_PATH=./data/hookrelay.db

# Explicitly allow delivering webhooks to localhost / 127.0.0.1 in development & test mode.
# Must be "false" in production to block loopback targets.
ALLOW_LOCALHOST_WEBHOOKS=true

# Background retry worker configuration
WORKER_POLL_INTERVAL_MS=1500
WORKER_CONCURRENCY=5
WEBHOOK_REQUEST_TIMEOUT_MS=10000
WEBHOOK_MAX_RESPONSE_BYTES=65536
WEBHOOK_MAX_PAYLOAD_BYTES=262144

# Public application URL (auto-injected in cloud environments)
APP_URL="http://localhost:3000"
